<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>BrokerProbe</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\NextDNSManager.Service\NextDNSManager.Service.csproj" />
    <Compile Include="..\..\NextDNSModernWPF\BrokerClient.cs" Link="BrokerClient.cs" />
    <Compile Include="..\..\Shared\ProfileSwitchSelection.cs" Link="ProfileSwitchSelection.cs" />
    <None Include="..\..\NextDNSModernWPF\Resources\Localization\broker-errors.json" Link="Resources\Localization\broker-errors.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
