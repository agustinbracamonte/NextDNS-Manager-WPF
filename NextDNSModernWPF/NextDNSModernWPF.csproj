<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Version>2.3.2</Version>
    <AssemblyVersion>2.3.2.0</AssemblyVersion>
    <FileVersion>2.3.2.0</FileVersion>
    <PublishTrimmed>false</PublishTrimmed>
    <Product>NextDNS Manager</Product>
    <Company>Agustín Bracamonte</Company>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
	<UseWindowsForms>true</UseWindowsForms>
	<ApplicationIcon>escudo_dns.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\BrokerProtocol.cs" Link="Shared\BrokerProtocol.cs" />
    <Compile Include="..\Shared\BrokerFailureCatalog.cs" Link="Shared\BrokerFailureCatalog.cs" />
    <Compile Include="..\Shared\ActivationFailureEnvelope.cs" Link="Shared\ActivationFailureEnvelope.cs" />
    <Compile Include="..\Shared\ActivationFailureSummaryFormatter.cs" Link="Shared\ActivationFailureSummaryFormatter.cs" />
    <Compile Include="..\Shared\ActivationPreflight.cs" Link="Shared\ActivationPreflight.cs" />
    <Compile Include="..\Shared\BrokerStatusRetryPolicy.cs" Link="Shared\BrokerStatusRetryPolicy.cs" />
    <Compile Include="..\Shared\DiagnosticLog.cs" Link="Shared\DiagnosticLog.cs" />
    <Compile Include="..\Shared\NetworkDiagnostics.cs" Link="Shared\NetworkDiagnostics.cs" />
    <Compile Include="..\Shared\ProfileSwitchSelection.cs" Link="Shared\ProfileSwitchSelection.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Localization\*.json" />
  </ItemGroup>

  <ItemGroup>
    <None Update="nextdns.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <Target Name="ValidateBundledNextDnsCli" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\nextdns.exe')"
           Text="Falta nextdns.exe junto al proyecto WPF. Ejecuta scripts\Prepare-NextDNSCli.ps1 antes de compilar o publicar." />
    <GetFileHash Files="$(MSBuildProjectDirectory)\nextdns.exe" Algorithm="SHA256"
                 Condition="Exists('$(MSBuildProjectDirectory)\nextdns.exe')">
      <Output TaskParameter="Items" ItemName="_NextDnsCliHash" />
    </GetFileHash>
    <Error Condition="Exists('$(MSBuildProjectDirectory)\nextdns.exe') and '%(_NextDnsCliHash.FileHash)' != '5A603C759BC4A854A6AAE46CADB91AE00A95BA5BB0591B985F49A95597856B8E'"
           Text="El SHA-256 de nextdns.exe no coincide con la release oficial fijada v1.50.2. Ejecuta scripts\Prepare-NextDNSCli.ps1." />
  </Target>

  <ItemGroup>
    <None Remove="escudo_dns.ico" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="escudo_dns.ico">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

</Project>
