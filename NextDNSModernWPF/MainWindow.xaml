                            <Button x:Name="btnDiagnostics" Height="30" HorizontalAlignment="Stretch" Padding="0"
                                    Background="Transparent" Foreground="{DynamicResource NextBlue}" BorderThickness="0"
                                    FontSize="12" Cursor="Hand" Style="{StaticResource DiagnosticLinkButton}" Click="BtnDiagnostics_Click" AutomationProperties.Name="{Binding [Main.Ui.Diagnostics.Accessible], Source={x:Static local:LocalizationManager.Instance}}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding [Main.Ui.Diagnostics.Label], Source={x:Static local:LocalizationManager.Instance}}" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text="{Binding [Main.Ui.Diagnostics.OpenLogs], Source={x:Static local:LocalizationManager.Instance}}" Foreground="{DynamicResource NextBlue}" TextDecorations="Underline"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>
