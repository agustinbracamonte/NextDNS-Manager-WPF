<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="CardColorValue">#BFEFF3F7</Color>
    <SolidColorBrush x:Key="WindowSurface" Color="#E4E8EEF4"/>
    <SolidColorBrush x:Key="WindowSurfaceBackdrop" Color="#A6E8EEF4"/>
    <SolidColorBrush x:Key="WindowSurfaceFallback" Color="#FFE8EEF4"/>
    <SolidColorBrush x:Key="CardColor" Color="{StaticResource CardColorValue}"/>
    <SolidColorBrush x:Key="PopupSurface" Color="#FFF4F6F9"/>
    <SolidColorBrush x:Key="NextBlue" Color="#FF1F68C1"/>
    <SolidColorBrush x:Key="NextRed" Color="#FFB3261E"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#FF1B1F24"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#FF5F6B76"/>
    <SolidColorBrush x:Key="BorderColor" Color="#8E8291A0"/>
    <SolidColorBrush x:Key="FocusBorderColor" Color="#FF1F68C1"/>

    <SolidColorBrush x:Key="WindowButtonHover" Color="#FFE7EBF0"/>
    <SolidColorBrush x:Key="WindowButtonPressed" Color="#FFD8DEE7"/>
    <SolidColorBrush x:Key="WindowButtonHoverForeground" Color="#FF1B1F24"/>
    <SolidColorBrush x:Key="CloseButtonHover" Color="#FFE81123"/>
    <SolidColorBrush x:Key="CloseButtonPressed" Color="#FFB50C19"/>
    <SolidColorBrush x:Key="CloseButtonHoverForeground" Color="#FFFFFFFF"/>

    <SolidColorBrush x:Key="ComboKeyboardFocus" Color="#FF17549D"/>
    <SolidColorBrush x:Key="ComboItemSelected" Color="#FFE0ECFA"/>
    <SolidColorBrush x:Key="ComboItemHover" Color="#FFEDF3FA"/>
    <SolidColorBrush x:Key="ComboItemSelectedForeground" Color="#FF1B1F24"/>
    <SolidColorBrush x:Key="ComboItemHoverForeground" Color="#FF1B1F24"/>
    <SolidColorBrush x:Key="ComboHoverBorder" Color="#FFA6B4C4"/>
    <SolidColorBrush x:Key="InputColor" Color="#DDE6EDF4"/>
    <SolidColorBrush x:Key="InputPlaceholder" Color="#FF697586"/>
    <SolidColorBrush x:Key="InputHoverBorder" Color="#FF9AA8B8"/>

    <SolidColorBrush x:Key="UpdateBackground" Color="#FFE8F1FC"/>
    <SolidColorBrush x:Key="UpdateForeground" Color="#FF164E8A"/>
    <SolidColorBrush x:Key="UpdateHoverBackground" Color="#FFD9E9FC"/>
    <SolidColorBrush x:Key="UpdatePressedBackground" Color="#FFC9DFF9"/>
    <SolidColorBrush x:Key="DeleteHoverForeground" Color="#FF9D2428"/>
    <SolidColorBrush x:Key="ActionButtonForeground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ActionButtonDestructiveBackground" Color="#FFFFFFFF"/>
