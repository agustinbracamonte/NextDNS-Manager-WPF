    <SolidColorBrush x:Key="StatusAttention" Color="#FF9A5700"/>
    <SolidColorBrush x:Key="StatusProtected" Color="#FF1B7F3A"/>
    <SolidColorBrush x:Key="NeutralPillBackground" Color="#D2E3EAF0"/>
    <SolidColorBrush x:Key="ProtectedPillBackground" Color="#401B7F3A"/>
    <SolidColorBrush x:Key="AttentionPillBackground" Color="#289A5700"/>
    <SolidColorBrush x:Key="ToggleOffBackground" Color="#B8D8E0E9"/>
</ResourceDictionary>
