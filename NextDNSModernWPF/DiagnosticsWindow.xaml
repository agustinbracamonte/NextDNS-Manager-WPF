<Window x:Class="NextDNSModernWPF.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registros de diagnóstico" Height="540" Width="760"
        MinHeight="360" MinWidth="520" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowSurface}" Foreground="{DynamicResource TextPrimary}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="La app conserva 30 días. Los eventos del servicio se filtran a 30 días desde el registro Aplicación de Windows. No incluyen datos de perfiles ni consultas."
                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10" TextWrapping="Wrap"/>

        <TextBox x:Name="txtDiagnostics" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="12" Padding="10"/>

        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="Actualizar" MinWidth="88" Height="32" Margin="0,0,8,0" Click="Refresh_Click"/>
                <Button Content="Abrir registros de la app" MinWidth="156" Height="32" Margin="0,0,8,0" Click="OpenManagerFolder_Click"/>
            </StackPanel>
            <Button Content="Cerrar" MinWidth="88" Height="32" Margin="8,0,0,0" IsCancel="True" Click="Close_Click"/>
        </DockPanel>
    </Grid>
</Window>
